# Copy this file to .env before local configuration.
# Do not commit .env or real webhook URLs.

DISCORD_WEBHOOK_URL=

# Minimum Market Bias confidence (0.0-1.0) required before any candidate is
# generated. Default matches docs/berial_spec.md chapter 29 (40%).
PAPER_SIGNAL_CONFIDENCE_THRESHOLD=0.40

# Do not re-generate a signal for the same symbol/timeframe/side within this
# many minutes.
PAPER_SIGNAL_DUPLICATE_WINDOW_MINUTES=60

# Only used when running signal_generator.py without --once (continuous loop).
PAPER_SIGNAL_CHECK_INTERVAL_SECONDS=900
