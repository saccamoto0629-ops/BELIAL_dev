# Copy this file to .env before local configuration.
# Do not commit .env or real webhook URLs.

DISCORD_WEBHOOK_URL=

# Minimum Market Bias confidence (0.0-1.0) required before any candidate is
# generated. Default matches docs/berial_spec.md chapter 29 (40%).
PAPER_SIGNAL_CONFIDENCE_THRESHOLD=0.40

# Do not re-generate a signal for the same symbol/timeframe/side within this
# many minutes.
PAPER_SIGNAL_DUPLICATE_WINDOW_MINUTES=60

# Only used when running signal_generator.py without --once (continuous loop).
PAPER_SIGNAL_CHECK_INTERVAL_SECONDS=900

# IANA timezone used to select the calendar day for daily reports.
# Defaults to Asia/Tokyo when unset.
PAPER_SIGNAL_REPORT_TIMEZONE=Asia/Tokyo

# Path to the Exit Policy JSON config for backtest evaluation (exit_policy.py).
# Paper-only: never a real order/stop/take-profit. This is the ONLY env
# setting for Exit Policy -- which policy is active, risk:reward, hold-bar
# limits, MA period, same-candle TP/SL priority, etc. all live in the JSON
# file, not in .env. Relative paths resolve against paper-signal/. If unset,
# a safe built-in default config is used (see default_exit_policy_config()).
BACKTEST_EXIT_CONFIG_PATH=config/backtest_exit_policy.json
