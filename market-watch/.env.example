# Copy this file to .env before local configuration.
# Do not commit .env or real webhook URLs.

DISCORD_WEBHOOK_URL=
DRY_RUN=true

# Public monitoring settings live in config.toml.
# Keep secrets in .env only.

# Chart Snapshot settings (chart_snapshot.py)
# Safe defaults use Yahoo Finance tickers and store SQLite under market-watch/data/.
CHART_SYMBOLS=USDJPY,XAUUSD,SPX,VIX
CHART_TIMEFRAMES=15m,1h,4h
CHART_HISTORY_PERIOD=60d
CHART_DB_PATH=data/chart_data.sqlite3
CHART_TICKER_USDJPY=JPY=X
CHART_TICKER_XAUUSD=GC=F
CHART_TICKER_SPX=^GSPC
CHART_TICKER_VIX=^VIX

# --- Optional: future OANDA data source ---
# Not used by the current (yfinance-based) implementation. See README.md
# "Future: switching to OANDA" for what would need to change in
# fetch_candles() to use these instead of Yahoo Finance.
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=
# OANDA_ENVIRONMENT=practice
