# Copy this file to .env before local configuration.
# Do not commit .env or real webhook URLs.

DISCORD_WEBHOOK_URL=
SYMBOL=USD_JPY
TIMEFRAME=M15
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
CHECK_INTERVAL_SECONDS=60

