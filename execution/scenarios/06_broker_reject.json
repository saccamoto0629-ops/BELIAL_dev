{
  "scenario_id": "broker_reject",
  "description": "Broker拒否: Brokerが確定的に拒否した注文はREJECTED(結果であり例外ではない)としてreject_reason付きで保存される",
  "broker": {
    "scripts": {
      "client-1": {
        "behavior": "reject",
        "reason": "insufficient margin"
      }
    }
  },
  "steps": [
    {
      "action": "register",
      "request": {
        "execution_request_id": "exec-1",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-1",
      "expect": {
        "outcome": "registered"
      }
    },
    {
      "action": "submit",
      "execution_request_id": "exec-1",
      "expect": {
        "outcome": "submitted",
        "state": "rejected"
      }
    }
  ],
  "expected": {
    "final_phase": "submitted",
    "final_state": "rejected",
    "state_history": [
      {
        "previous_state": null,
        "new_state": "pending",
        "reason": "live submission via safety gate",
        "broker_order_id": null
      },
      {
        "previous_state": "pending",
        "new_state": "rejected",
        "reason": "live submission via safety gate",
        "broker_order_id": null
      }
    ],
    "broker_submit_calls": 1,
    "order_rows": 1,
    "broker_order_id": null,
    "filled_quantity": "0",
    "average_fill_price": null,
    "reject_reason": "insufficient margin",
    "listed_unknown": false,
    "listed_unresolved": false
  }
}
