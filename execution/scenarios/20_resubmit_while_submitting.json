{
  "scenario_id": "resubmit_while_submitting",
  "description": "SUBMITTING状態の再実行: 別workerがcreated→submitting遷移を獲得済みのRequestはduplicate_submissionで拒否され、Brokerは呼ばれず、未解決submissionとして照会対象に残る",
  "steps": [
    {
      "action": "register",
      "request": {
        "execution_request_id": "exec-1",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-1",
      "expect": {
        "outcome": "registered"
      }
    },
    {
      "action": "mark_submitting",
      "execution_request_id": "exec-1",
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "action": "submit",
      "execution_request_id": "exec-1",
      "expect": {
        "outcome": "rejected",
        "rejection_codes": [
          "duplicate_submission"
        ]
      }
    }
  ],
  "expected": {
    "final_phase": "submitting",
    "final_state": "pending",
    "state_history": [
      {
        "previous_state": null,
        "new_state": "pending",
        "reason": "scenario: another worker won the transition",
        "broker_order_id": null
      }
    ],
    "broker_submit_calls": 0,
    "listed_unknown": false,
    "listed_unresolved": true
  }
}
