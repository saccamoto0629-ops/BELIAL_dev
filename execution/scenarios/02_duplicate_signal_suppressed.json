{
  "scenario_id": "duplicate_signal_suppressed",
  "description": "同一Signalの重複処理: 同じsignal_idからの2件目のExecution Request生成はUNIQUE制約で抑止され、行は1件のまま",
  "steps": [
    {
      "action": "register",
      "request": {
        "execution_request_id": "exec-1",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-1",
      "expect": {
        "outcome": "registered"
      }
    },
    {
      "action": "register",
      "request": {
        "execution_request_id": "exec-2",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-2",
      "expect": {
        "outcome": "conflict"
      }
    },
    {
      "action": "submit",
      "execution_request_id": "exec-1",
      "expect": {
        "outcome": "submitted",
        "state": "filled"
      }
    }
  ],
  "expected": {
    "final_state": "filled",
    "order_rows": 1,
    "history_rows": 2,
    "broker_submit_calls": 1
  }
}
