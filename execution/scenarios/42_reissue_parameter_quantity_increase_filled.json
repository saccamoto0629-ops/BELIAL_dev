{
  "scenario_id": "reissue_parameter_quantity_increase_filled",
  "description": "parameter拒否の増量訂正 (Issue #116): rejection_category=parameterの確定拒否に限り、policy比率上限内の増量つき手動再発行が成立し、子は通常のGate経由で約定する",
  "broker": {
    "scripts": {
      "client-1": {
        "behavior": "reject",
        "reason": "quantity below the instrument minimum",
        "category": "parameter"
      },
      "client-2": {
        "behavior": "fill_immediately",
        "broker_order_id": "BRK-2"
      }
    }
  },
  "steps": [
    {
      "action": "register",
      "request": {
        "execution_request_id": "exec-1",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-1",
      "expect": {
        "outcome": "registered"
      }
    },
    {
      "action": "submit",
      "execution_request_id": "exec-1",
      "expect": {
        "outcome": "submitted",
        "state": "rejected"
      }
    },
    {
      "action": "grant_clearance",
      "signal_id": "signal-1",
      "expect": {
        "outcome": "granted"
      }
    },
    {
      "action": "manual_reissue",
      "request": {
        "execution_request_id": "exec-2",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "2",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-2",
      "parent_execution_request_id": "exec-1",
      "operator_id": "op-1",
      "reason": "minimum size correction: increase 1 -> 2 within the policy ratio cap",
      "expect": {
        "outcome": "registered"
      }
    },
    {
      "action": "submit",
      "execution_request_id": "exec-2",
      "expect": {
        "outcome": "submitted",
        "state": "filled"
      }
    }
  ],
  "expected": {
    "broker_submit_calls": 2,
    "order_rows": 2,
    "chain": [
      {
        "execution_request_id": "exec-1",
        "signal_attempt": 1,
        "submission_phase": "submitted",
        "order_state": "rejected"
      },
      {
        "execution_request_id": "exec-2",
        "signal_attempt": 2,
        "submission_phase": "submitted",
        "order_state": "filled"
      }
    ],
    "listed_unknown": false,
    "listed_unresolved": false
  }
}
