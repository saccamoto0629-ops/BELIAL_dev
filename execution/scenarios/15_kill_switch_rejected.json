{
  "scenario_id": "kill_switch_rejected",
  "description": "kill switchによる拒否: kill switch有効時はkill_switch_enabledで全新規注文が拒否され、Brokerは一度も呼ばれない",
  "gate": {
    "kill_switch": true
  },
  "steps": [
    {
      "action": "register",
      "request": {
        "execution_request_id": "exec-1",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-1",
      "expect": {
        "outcome": "registered"
      }
    },
    {
      "action": "submit",
      "execution_request_id": "exec-1",
      "expect": {
        "outcome": "rejected",
        "rejection_codes": [
          "kill_switch_enabled"
        ]
      }
    }
  ],
  "expected": {
    "final_phase": "created",
    "broker_submit_calls": 0,
    "safety_decisions": 1,
    "last_decision_allowed": false,
    "last_decision_codes": [
      "kill_switch_enabled"
    ]
  }
}
