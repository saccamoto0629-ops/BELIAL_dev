        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "shadow-client-1",
      "expect": {
        "outcome": "recorded",
        "allowed": true
      }
    },
    {
      "action": "shadow",
      "request": {
        "execution_request_id": "shadow-exec-1",
        "signal_id": "shadow-signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "shadow-client-1",
      "expect": {
        "outcome": "duplicate",
        "allowed": true
      }
    }
