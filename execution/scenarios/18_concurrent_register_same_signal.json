            "side": "buy",
            "order_type": "market",
            "quantity": "1",
            "stop_loss_price": "149.50",
            "take_profit_price": "151.50"
          },
          "client_order_id": "client-2"
        },
        {
          "request": {
            "execution_request_id": "exec-3",
            "signal_id": "signal-1",
            "strategy_id": "strategy-1",
            "symbol": "USD_JPY",
