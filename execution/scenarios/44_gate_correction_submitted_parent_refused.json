{
  "scenario_id": "gate_correction_submitted_parent_refused",
  "description": "送信済み親の差し替え拒否 (Issue #116): Journal/Brokerへ送信された親(phase created ではない = Journal not_started ではない)は、有効なclearanceがあっても訂正差し替えの対象にならない",
  "broker": {
    "scripts": {
      "client-1": {
        "behavior": "stay_pending",
        "broker_order_id": "BRK-1"
      }
    }
  },
  "steps": [
    {
      "action": "register",
      "request": {
        "execution_request_id": "exec-1",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "5",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-1",
      "expect": {
        "outcome": "registered"
      }
    },
    {
      "action": "submit",
      "execution_request_id": "exec-1",
      "expect": {
        "outcome": "submitted",
        "state": "accepted"
      }
    },
    {
      "action": "grant_clearance",
      "signal_id": "signal-1",
      "expect": {
        "outcome": "granted"
      }
    },
    {
      "action": "gate_correction",
      "request": {
        "execution_request_id": "exec-2",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "4",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-2",
      "parent_execution_request_id": "exec-1",
      "operator_id": "op-1",
      "reason": "must be refused: the parent was submitted (journal past not_started)",
      "expect": {
        "outcome": "refused",
        "error_type": "ReissueEligibilityError"
      }
    }
  ],
  "expected": {
    "final_phase": "submitted",
    "final_state": "accepted",
    "broker_submit_calls": 1,
    "order_rows": 1,
    "chain": [
      {
        "execution_request_id": "exec-1",
        "signal_attempt": 1,
        "submission_phase": "submitted",
        "order_state": "accepted"
      }
    ],
    "journal_outcomes": {
      "exec-1": "completed"
    },
    "listed_unknown": false,
    "listed_unresolved": false
  }
}
