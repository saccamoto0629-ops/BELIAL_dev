{
  "scenario_id": "shadow_concurrent_single_record",
  "description": "Shadow Mode多重起動競合: 同じrequestを並行実行してもShadow結果は1件、敗者は明示的なduplicateとなり、DB lockエラーが成功扱いされることはない(error 0件を要求)",
  "steps": [
    {
      "action": "shadow_concurrent",
      "request": {
        "execution_request_id": "shadow-exec-1",
        "signal_id": "shadow-signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "shadow-client-1",
      "workers": 2,
      "expect": {
        "recorded": 1,
        "duplicates": 1,
        "errors": 0
      }
    }
  ],
  "expected": {
    "broker_submit_calls": 0,
    "shadow_rows": 1,
    "shadow_allowed": true
  }
}
