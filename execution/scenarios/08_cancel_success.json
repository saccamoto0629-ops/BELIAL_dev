        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-1",
      "expect": {
        "outcome": "registered"
      }
    },
    {
