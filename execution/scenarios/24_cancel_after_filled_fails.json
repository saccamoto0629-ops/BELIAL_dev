{
  "scenario_id": "cancel_after_filled_fails",
  "description": "約定済み注文のキャンセル失敗: FILLED(terminal)の注文へのキャンセルはBrokerがcancellation_failureで拒否し、状態は変化しない",
  "broker": {
    "scripts": {
      "client-1": {
        "behavior": "fill_immediately",
        "price": "150.25",
        "broker_order_id": "BRK-24"
      }
    }
  },
  "steps": [
    {
      "action": "register",
      "request": {
        "execution_request_id": "exec-1",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-1",
      "expect": {
        "outcome": "registered"
      }
    },
    {
      "action": "submit",
      "execution_request_id": "exec-1",
      "expect": {
        "outcome": "submitted",
        "state": "filled"
      }
    },
    {
      "action": "cancel",
      "execution_request_id": "exec-1",
      "expect": {
        "outcome": "error",
        "error_type": "BrokerCancellationError",
        "error_code": "cancellation_failure"
      }
    }
  ],
  "expected": {
    "final_state": "filled",
    "broker_submit_calls": 1,
    "broker_cancel_calls": 1,
    "filled_quantity": "1"
  }
}
