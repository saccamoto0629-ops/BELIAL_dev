{
  "scenario_id": "concurrent_submit_single_broker_call",
  "description": "多重起動相当の競合: 同じExecution Requestを4workerがbarrier同期で同時にsubmitしてもBroker呼び出しは最大1回。敗者はduplicate_submissionとして明示され、重複行は残らない",
  "broker": {
    "scripts": {
      "client-1": {
        "behavior": "fill_immediately",
        "price": "150.25",
        "broker_order_id": "BRK-17"
      }
    }
  },
  "steps": [
    {
      "action": "register",
      "request": {
        "execution_request_id": "exec-1",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "client-1",
      "expect": {
        "outcome": "registered"
      }
    },
    {
      "action": "submit_concurrent",
      "execution_request_id": "exec-1",
      "workers": 4,
      "expect": {
        "submitted": 1,
        "rejected": 3,
        "errors": 0,
        "rejection_codes": [
          "duplicate_submission"
        ]
      }
    }
  ],
  "expected": {
    "final_phase": "submitted",
    "final_state": "filled",
    "state_history": [
      [
        null,
        "pending"
      ],
      [
        "pending",
        "filled"
      ]
    ],
    "broker_submit_calls": 1,
    "order_rows": 1,
    "history_rows": 2
  }
}
