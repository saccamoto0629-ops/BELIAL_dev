{
  "scenario_id": "shadow_payload_conflict",
  "description": "同一identity・異payloadのconflict: 同じexecution_request_idでquantityが異なる2回目の処理はduplicateではなく明示的なconflictになり、既存結果を黙って返さずSafety Decisionも増えない",
  "steps": [
    {
      "action": "shadow",
      "request": {
        "execution_request_id": "shadow-exec-1",
        "signal_id": "shadow-signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "1",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "shadow-client-1",
      "expect": {
        "outcome": "recorded",
        "allowed": true
      }
    },
    {
      "action": "shadow",
      "request": {
        "execution_request_id": "shadow-exec-1",
        "signal_id": "shadow-signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
        "order_type": "market",
        "quantity": "2",
        "stop_loss_price": "149.50",
        "take_profit_price": "151.50"
      },
      "client_order_id": "shadow-client-1",
      "expect": {
        "outcome": "conflict",
        "error_type": "ShadowIdentityConflictError",
        "conflict_fields": [
          "quantity"
        ]
      }
    }
  ],
  "expected": {
    "broker_submit_calls": 0,
    "shadow_rows": 1,
    "shadow_claim_rows": 0,
    "shadow_allowed": true,
    "safety_decisions": 1
  }
}
