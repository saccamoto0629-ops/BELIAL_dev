{
  "scenario_id": "cancel_terminal_state_refused",
  "description": "terminal注文のキャンセル失敗: FILLED済み注文へのcancelはBrokerを呼ばずにローカルで型付き拒否され、terminal状態は不変のまま(Issue #99)",
  "broker": {
    "scripts": {
      "client-1": {
        "behavior": "fill_immediately",
        "price": "150.25",
        "broker_order_id": "BRK-1"
      }
    }
  },
  "steps": [
    {
      "action": "register",
      "request": {
        "execution_request_id": "exec-1",
        "signal_id": "signal-1",
        "strategy_id": "strategy-1",
        "symbol": "USD_JPY",
        "side": "buy",
