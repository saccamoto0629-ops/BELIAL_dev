# Copy this file to .env before local configuration.
# Do not commit .env or real secrets. (This file holds no secrets.)

# Optional: override the Paper Execution virtual-position DB path.
#
# Purpose:   SQLite DB storing virtual positions (Paper Execution). Independent
#            of the Paper Signal / Chart / Backtest DBs.
# Default:   paper-execution/data/paper_positions.sqlite3
# Relative:  relative paths are resolved against paper-execution/.
# Prod:      set an absolute path on a persistent volume, e.g.
#            /var/lib/berial/paper_positions.sqlite3
# dry-run:   never created or migrated on a dry run (read-only schema check only).
# Migration: a normal (non-dry) run migrates a legacy DB to the current schema
#            automatically at startup, before reading any position.
PAPER_POSITION_DB_PATH=
