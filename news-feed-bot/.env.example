# Copy this file to .env before local configuration.
# Do not commit .env or real webhook URLs.

NEWS_WEBHOOK_URL=
DEV_LOG_WEBHOOK_URL=

# Safe default: true means no Discord sends and no posted_ids.json updates.
# For real production posting, set DRY_RUN=false after setting NEWS_WEBHOOK_URL.
DRY_RUN=true
DEBUG_SELECTION=false

# Optional settings
GOOGLE_NEWS_QUERY=site:reuters.com (markets OR stocks OR bonds OR forex OR commodities OR oil OR gold OR "central bank" OR inflation OR "interest rates" OR earnings) when:1d
MAX_ARTICLES_PER_RUN=5
MAX_TOTAL_ARTICLES_PER_RUN=5
FETCH_INTERVAL_MINUTES=60

# Market snapshot (market_snapshot.py)
# Optional: without a FRED_API_KEY, the [Rates / FRED] section is skipped.
FRED_API_KEY=
MARKET_SNAPSHOT_ENABLED=true
MARKET_SNAPSHOT_TIME=07:00
# Optional: persisted Market Bias DB for Backtest / Paper Signal lookup.
# Dry-run does not create or update this DB.
MARKET_BIAS_DB_PATH=data/market_bias.sqlite3

# Optional external website providers.
# Defaults are false because these sites may timeout or return 403.
ENABLE_FEDWATCH=false
ENABLE_ECONOMIC_CALENDAR=false
