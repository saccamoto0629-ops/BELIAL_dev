# Copy this file to .env before local configuration.
# Do not commit .env or real webhook URLs.

NEWS_WEBHOOK_URL=
DEV_LOG_WEBHOOK_URL=

# Safe default: true means no Discord sends and no posted_ids.json updates.
# For real production posting, set DRY_RUN=false after setting NEWS_WEBHOOK_URL.
DRY_RUN=true

# Optional settings
GOOGLE_NEWS_QUERY=site:reuters.com (markets OR stocks OR bonds OR forex OR commodities OR oil OR gold OR "central bank" OR inflation OR "interest rates" OR earnings) when:1d
MAX_ARTICLES_PER_RUN=5
MAX_TOTAL_ARTICLES_PER_RUN=5
FETCH_INTERVAL_MINUTES=60
